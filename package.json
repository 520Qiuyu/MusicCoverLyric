{
  "name": "musiccoverlyric",
  "version": "1.0.2",
  "description": "用于给音乐批量嵌入封面与歌词",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "type": "commonjs",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build",
    "test": "ts-node src/demo/embed.ts"
  },
  "keywords": [
    "flac",
    "cover",
    "lyric"
  ],
  "author": "qiuyu",
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.6.0",
    "dts-bundle-generator": "^9.5.1",
    "typescript": "^6.0.3"
  }
}
